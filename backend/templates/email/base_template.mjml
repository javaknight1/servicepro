<mjml>
  <mj-head>
    <mj-title>{{.Subject}}</mj-title>
    <mj-preview>{{.PreviewText}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text font-size="14px" line-height="1.6" color="#374151" />
      <mj-button background-color="{{.PrimaryColor | default "#2563eb"}}" color="#ffffff" border-radius="6px" font-size="16px" font-weight="600" />
    </mj-attributes>
    <mj-style inline="inline">
      .link-color { color: {{.PrimaryColor | default "#2563eb"}}; }
      .text-muted { color: #6b7280; }
      .text-small { font-size: 12px; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f3f4f6">
    <!-- Header -->
    <mj-section background-color="{{.PrimaryColor | default "#2563eb"}}" padding="20px 0">
      <mj-column>
        {{if .CompanyLogo}}
        <mj-image src="{{.CompanyLogo}}" alt="{{.CompanyName}}" width="150px" />
        {{else}}
        <mj-text font-size="24px" font-weight="bold" color="#ffffff" align="center">
          {{.CompanyName | default "ServicePro"}}
        </mj-text>
        {{end}}
      </mj-column>
    </mj-section>

    <!-- Main Content Area -->
    <mj-section background-color="#ffffff" padding="40px 30px" border-radius="8px 8px 0 0">
      <mj-column>
        {{if .Heading}}
        <mj-text font-size="24px" font-weight="bold" color="#111827" padding-bottom="20px">
          {{.Heading}}
        </mj-text>
        {{end}}

        {{if .RecipientName}}
        <mj-text padding-bottom="15px">
          Hello {{.RecipientName}},
        </mj-text>
        {{end}}

        <mj-text>
          {{.Body}}
        </mj-text>

        {{if .ActionURL}}
        <mj-button href="{{.ActionURL}}" padding="30px 0">
          {{.ActionText | default "Take Action"}}
        </mj-button>
        {{end}}
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f9fafb" padding="30px" border-radius="0 0 8px 8px">
      <mj-column>
        {{if .Footer}}
        <mj-text font-size="13px" color="#6b7280" align="center">
          {{.Footer}}
        </mj-text>
        {{end}}

        <mj-divider border-color="#e5e7eb" border-width="1px" padding="20px 0" />

        <mj-text font-size="12px" color="#9ca3af" align="center">
          {{.CompanyName | default "ServicePro"}}
          {{if .CompanyAddress}}<br/>{{.CompanyAddress}}{{end}}
          {{if .CompanyPhone}}<br/>{{.CompanyPhone}}{{end}}
        </mj-text>

        {{if .UnsubscribeURL}}
        <mj-text font-size="11px" color="#9ca3af" align="center" padding-top="15px">
          <a href="{{.UnsubscribeURL}}" class="link-color">Unsubscribe</a> from these emails
        </mj-text>
        {{end}}

        <mj-text font-size="11px" color="#9ca3af" align="center" padding-top="10px">
          &copy; {{.CurrentYear}} {{.CompanyName | default "ServicePro"}}. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Spacer -->
    <mj-section padding="20px 0">
      <mj-column>
        <mj-text font-size="1px" color="#f3f4f6">.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
