# =============================================================================
# ServicePro Backend Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment
# NEVER commit .env files with real credentials to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Application port (default: 8080)
PORT=8080

# Environment: development | staging | production
ENV=development

# Frontend URL for CORS and email links
FRONTEND_URL=http://localhost:5173

# API base path prefix
API_PREFIX=/api/v1

# Graceful shutdown timeout
SHUTDOWN_TIMEOUT=30s

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
# Full connection URL (takes precedence over individual settings)
DATABASE_URL=postgresql://postgres:password@localhost:5432/servicepro?sslmode=disable

# Individual connection settings (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=servicepro
DB_SSL_MODE=disable

# Connection pool settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=5m

# Query timeout
DB_QUERY_TIMEOUT=30s

# Enable query logging (development only)
DB_LOG_QUERIES=true

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Redis connection URL
REDIS_URL=redis://localhost:6379

# Individual settings (used if REDIS_URL is not set)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Connection pool
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5

# Timeouts
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# -----------------------------------------------------------------------------
# Authentication & JWT
# -----------------------------------------------------------------------------
# JWT signing secret (MUST be changed in production - use 256+ bit random string)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-this-in-production-min-32-chars

# Token expiration times
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Token issuer
JWT_ISSUER=servicepro

# Password hashing cost (10-14 recommended)
BCRYPT_COST=12

# Account lockout settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15m

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Global rate limit (requests per minute per IP)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# Authentication endpoints (stricter limits)
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW=1m

# API endpoints
RATE_LIMIT_API_REQUESTS=60
RATE_LIMIT_API_WINDOW=1m

# Enable rate limiting
RATE_LIMIT_ENABLED=true

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Allowed methods
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Allowed headers
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-ID

# Expose headers to client
CORS_EXPOSED_HEADERS=X-Request-ID,X-RateLimit-Remaining

# Max age for preflight cache (seconds)
CORS_MAX_AGE=86400

# Allow credentials
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------------------------
# AWS Region
AWS_REGION=us-east-1

# AWS Credentials (use IAM roles in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 Configuration
S3_BUCKET_NAME=servicepro-uploads
S3_ENDPOINT=              # Leave empty for AWS, set for LocalStack/MinIO
S3_FORCE_PATH_STYLE=false # Set true for LocalStack/MinIO

# SES Configuration (email)
SES_SENDER_EMAIL=noreply@servicepro.local
SES_SENDER_NAME=ServicePro

# -----------------------------------------------------------------------------
# Email Configuration
# -----------------------------------------------------------------------------
# SMTP settings (for development, use MailHog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@servicepro.local
SMTP_FROM_NAME=ServicePro

# Use TLS
SMTP_USE_TLS=false

# Email verification settings
EMAIL_VERIFICATION_EXPIRY=24h
PASSWORD_RESET_EXPIRY=1h

# -----------------------------------------------------------------------------
# File Upload Configuration
# -----------------------------------------------------------------------------
# Maximum file size (in bytes)
MAX_UPLOAD_SIZE=10485760

# Allowed file types (MIME types, comma-separated)
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Upload directory (local storage)
UPLOAD_DIR=./uploads

# Storage driver: local | s3
STORAGE_DRIVER=local

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log level: debug | info | warn | error
LOG_LEVEL=debug

# Log format: json | text
LOG_FORMAT=text

# Log output: stdout | file
LOG_OUTPUT=stdout

# Log file path (when LOG_OUTPUT=file)
LOG_FILE_PATH=./logs/app.log

# Enable request logging
LOG_REQUESTS=true

# Enable query logging
LOG_QUERIES=true

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------
# Enable Prometheus metrics endpoint
METRICS_ENABLED=true
METRICS_PATH=/metrics

# Enable pprof profiling (development only)
PPROF_ENABLED=true

# Health check endpoint
HEALTH_PATH=/health

# Readiness check endpoint
READY_PATH=/ready

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable email verification requirement
REQUIRE_EMAIL_VERIFICATION=true

# Enable WebSocket notifications
WEBSOCKET_ENABLED=true

# Enable recurring jobs scheduler
RECURRING_JOBS_ENABLED=true

# Enable Stripe integration
STRIPE_ENABLED=false

# -----------------------------------------------------------------------------
# Stripe Configuration (if enabled)
# -----------------------------------------------------------------------------
# To get your Stripe API keys:
# 1. Create a Stripe account at https://stripe.com
# 2. Go to Developers > API Keys in the Stripe Dashboard
# 3. For testing, use the "Test mode" keys (prefixed with sk_test_ and pk_test_)
# 4. For production, use "Live mode" keys (prefixed with sk_live_ and pk_live_)
# 5. For webhook secret, go to Developers > Webhooks and create an endpoint
#
# NEVER commit real API keys to version control
# In production, use environment variables or a secrets manager
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs for subscription tiers
# Create products/prices in Stripe Dashboard > Products
# Use price IDs that look like: price_xxxxxxxxxxxxx
STRIPE_PRICE_FREE_MONTHLY=
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Stripe logging level: debug | info | warn | error
STRIPE_LOG_LEVEL=info

# Maximum retry attempts for Stripe API calls
STRIPE_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# External Services
# -----------------------------------------------------------------------------
# Tax service API (for tax calculations)
TAX_SERVICE_URL=
TAX_SERVICE_API_KEY=

# Geocoding service
GEOCODING_SERVICE_URL=
GEOCODING_API_KEY=

# -----------------------------------------------------------------------------
# Testing Configuration
# -----------------------------------------------------------------------------
# Test database URL
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/servicepro_test?sslmode=disable

# Disable rate limiting in tests
TEST_DISABLE_RATE_LIMIT=true
