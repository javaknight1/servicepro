{
  "name": "servicepro-frontend",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:analyze": "ANALYZE=true tsc && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "cf:dev": "vite build && wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:typegen": "wrangler types worker/worker-configuration.d.ts --strict-vars=false && prettier --log-level warn --write worker/worker-configuration.d.ts",
    "type-check": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "analyze:bundle": "node scripts/analyze-bundle.cjs",
    "optimize:images": "node scripts/optimize-images.js",
    "audit:deps": "node scripts/audit-deps.js",
    "generate:api": "swagger2openapi ../backend/docs/swagger.json -o src/types/openapi.json && openapi-typescript src/types/openapi.json -o src/types/api.generated.ts",
    "dead-code": "node scripts/check-dead-code.js",
    "dead-code:update": "node scripts/check-dead-code.js --update",
    "dead-code:list": "node scripts/check-dead-code.js --list"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.19",
    "@hookform/resolvers": "^5.9.2",
    "@sentry/react": "^10.76.2",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.6.1",
    "@tanstack/query-sync-storage-persister": "^5.104.2",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-persist-client": "^5.104.2",
    "axios": "^1.20.0",
    "chart.js": "^4.4.1",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.323.0",
    "posthog-js": "^1.347.2",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.0.5",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.104.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^25.0.10",
    "@types/react": "^18.3.27",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.0.17",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^27.4.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.35",
    "prettier": "^3.9.10",
    "react-big-calendar": "^1.20.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "sharp": "^0.35.5",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "^3.4.19",
    "terser": "^5.51.2",
    "ts-prune": "^0.10.3",
    "typescript": "^5.3.3",
    "vite": "^5.4.21",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.0.17",
    "wrangler": "^4.151.0"
  }
}
