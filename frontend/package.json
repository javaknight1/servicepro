{
  "name": "servicepro-frontend",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-chunk-cycles.cjs",
    "build:analyze": "ANALYZE=true tsc && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "cf:dev": "vite build && wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:typegen": "wrangler types worker/worker-configuration.d.ts --strict-vars=false && prettier --log-level warn --write worker/worker-configuration.d.ts",
    "type-check": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "analyze:bundle": "node scripts/analyze-bundle.cjs",
    "optimize:images": "node scripts/optimize-images.js",
    "audit:deps": "node scripts/audit-deps.js",
    "generate:api": "swagger2openapi ../backend/docs/swagger.json -o src/types/openapi.json && openapi-typescript src/types/openapi.json -o src/types/api.generated.ts",
    "dead-code": "node scripts/check-dead-code.js",
    "dead-code:update": "node scripts/check-dead-code.js --update",
    "dead-code:list": "node scripts/check-dead-code.js --list"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^6.0.0",
    "@sentry/react": "^11.9.0",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "@tanstack/query-sync-storage-persister": "^5.104.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-persist-client": "^5.104.5",
    "axios": "^1.20.0",
    "chart.js": "^4.6.1",
    "clsx": "^2.1.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.61.0",
    "posthog-js": "^1.438.21",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "baseline-browser-mapping": "^2.11.33",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "react-big-calendar": "^1.20.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.5",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "ts-prune": "^0.10.3",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  }
}
