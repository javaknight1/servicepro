{
  "name": "servicepro-frontend",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:analyze": "ANALYZE=true tsc && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "analyze:bundle": "node scripts/analyze-bundle.cjs",
    "optimize:images": "node scripts/optimize-images.js",
    "audit:deps": "node scripts/audit-deps.js",
    "generate:api": "swagger2openapi ../backend/docs/swagger.json -o src/types/openapi.json && openapi-typescript src/types/openapi.json -o src/types/api.generated.ts",
    "dead-code": "node scripts/check-dead-code.js",
    "dead-code:update": "node scripts/check-dead-code.js --update",
    "dead-code:list": "node scripts/check-dead-code.js --list"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.19",
    "@hookform/resolvers": "^3.10.0",
    "@react-pdf/renderer": "^4.3.2",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.9.0",
    "@tanstack/query-sync-storage-persister": "^5.90.24",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "^5.90.24",
    "axios": "^1.13.6",
    "chart.js": "^4.4.1",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.577.0",
    "posthog-js": "^1.360.2",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.0.5",
    "react-hook-form": "^7.71.2",
    "react-router-dom": "^6.30.2",
    "workbox-background-sync": "^7.3.0",
    "workbox-cacheable-response": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@sentry/react": "^10.43.0",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.27",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.27",
    "baseline-browser-mapping": "^2.10.8",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^27.4.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.35",
    "prettier": "^3.8.1",
    "react-big-calendar": "^1.19.4",
    "rollup-plugin-visualizer": "^6.0.5",
    "sharp": "^0.34.5",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "^3.4.19",
    "terser": "^5.46.1",
    "ts-prune": "^0.10.3",
    "typescript": "^5.3.3",
    "vite": "^5.4.21",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^4.0.17",
    "workbox-window": "^7.3.0"
  }
}
