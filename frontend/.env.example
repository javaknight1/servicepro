# =============================================================================
# ServicePro Frontend Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment
# All variables must be prefixed with VITE_ to be exposed to the client
# NEVER commit .env files with real credentials to version control
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Backend API URL (include /api prefix if applicable)
VITE_API_URL=http://localhost:8080/api/v1

# WebSocket URL for real-time notifications
VITE_WS_URL=ws://localhost:8080/ws

# API timeout (milliseconds)
VITE_API_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Application name (displayed in title, header)
VITE_APP_NAME=ServicePro

# Application version (auto-populated from package.json in build)
VITE_APP_VERSION=1.0.0

# Environment indicator
VITE_ENV=development

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable WebSocket real-time updates
VITE_ENABLE_WEBSOCKET=true

# Enable service worker for offline support
VITE_ENABLE_SERVICE_WORKER=false

# Enable analytics tracking
VITE_ENABLE_ANALYTICS=false

# Enable debug mode (extra console logging)
VITE_DEBUG=true

# Enable mock API (for development without backend)
VITE_ENABLE_MOCK_API=false

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Token storage key
VITE_TOKEN_KEY=servicepro_token

# Refresh token storage key
VITE_REFRESH_TOKEN_KEY=servicepro_refresh_token

# Session timeout warning (seconds before expiry)
VITE_SESSION_TIMEOUT_WARNING=300

# -----------------------------------------------------------------------------
# UI Configuration
# -----------------------------------------------------------------------------
# Default theme: light | dark | system
VITE_DEFAULT_THEME=system

# Default language
VITE_DEFAULT_LOCALE=en

# Items per page (pagination default)
VITE_DEFAULT_PAGE_SIZE=25

# Enable toast notifications
VITE_ENABLE_TOASTS=true

# Toast duration (milliseconds)
VITE_TOAST_DURATION=5000

# -----------------------------------------------------------------------------
# File Upload
# -----------------------------------------------------------------------------
# Maximum file size (bytes) - should match backend
VITE_MAX_UPLOAD_SIZE=10485760

# Allowed file types (comma-separated MIME types)
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# -----------------------------------------------------------------------------
# Maps & Geolocation
# -----------------------------------------------------------------------------
# Google Maps API key (for job location features)
VITE_GOOGLE_MAPS_API_KEY=

# Default map center (lat,lng)
VITE_DEFAULT_MAP_CENTER=40.7128,-74.0060

# Default map zoom level
VITE_DEFAULT_MAP_ZOOM=12

# -----------------------------------------------------------------------------
# External Services
# -----------------------------------------------------------------------------
# Stripe publishable key (for payment features)
VITE_STRIPE_PUBLISHABLE_KEY=

# Sentry DSN (for error tracking)
VITE_SENTRY_DSN=

# Google Analytics ID
VITE_GA_TRACKING_ID=

# -----------------------------------------------------------------------------
# Development & Testing
# -----------------------------------------------------------------------------
# Enable React DevTools
VITE_ENABLE_DEVTOOLS=true

# Enable React Query DevTools
VITE_ENABLE_QUERY_DEVTOOLS=true

# Mock API delay (milliseconds) - simulates network latency
VITE_MOCK_API_DELAY=500

# E2E testing base URL
VITE_E2E_BASE_URL=http://localhost:5173
