{
  // Typecheck for the edge Worker only. Uses the Workers runtime types
  // generated by `npm run cf:typegen` (worker-configuration.d.ts) instead of
  // the DOM libs the React app uses; the app tsconfig only includes src/.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["./worker-configuration.d.ts"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["./**/*.ts"]
}
