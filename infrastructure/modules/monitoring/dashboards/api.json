{
  "widgets": [
    {
      "height": 2,
      "width": 24,
      "y": 0,
      "x": 0,
      "type": "text",
      "properties": {
        "markdown": "# ServicePro API Dashboard\n\nDetailed API performance monitoring including endpoints, methods, and response codes.\n\n**Environment:** ${ENVIRONMENT} | **Region:** ${AWS_REGION}"
      }
    },
    {
      "height": 3,
      "width": 4,
      "y": 2,
      "x": 0,
      "type": "metric",
      "properties": {
        "metrics": [
          [
            "ServicePro/${ENVIRONMENT}/API",
            "RequestCount",
            {
              "stat": "Sum",
              "period": 60
            }
          ]
        ],
        "view": "singleValue",
        "region": "${AWS_REGION}",
        "title": "Requests/min",
        "period": 60,
        "stat": "Sum"
      }
    },
    {
      "height": 3,
      "width": 4,
