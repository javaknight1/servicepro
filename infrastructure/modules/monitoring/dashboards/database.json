    },
    {
      "height": 2,
      "width": 24,
      "y": 2,
      "x": 0,
      "type": "text",
      "properties": {
        "markdown": "## PostgreSQL RDS Metrics"
      }
    },
    {
      "height": 3,
      "width": 6,
      "y": 4,
      "x": 0,
      "type": "metric",
      "properties": {
        "metrics": [
          [
            "AWS/RDS",
            "DatabaseConnections",
            "DBInstanceIdentifier",
            "${DB_INSTANCE_ID}",
            {
              "stat": "Average",
              "period": 60
            }
          ]
        ],
        "view": "singleValue",
        "region": "${AWS_REGION}",
        "title": "Active Connections",
        "period": 60,
        "stat": "Average"
      }
    },
    {
      "height": 3,
      "width": 6,
      "y": 4,
