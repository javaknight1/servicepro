        "view": "singleValue",
        "region": "${AWS_REGION}",
        "title": "CPU Utilization",
        "period": 60,
        "stat": "Average",
        "annotations": {
          "horizontal": [
            {
              "color": "#ff7f0e",
              "value": 70
            },
            {
              "color": "#d62728",
              "value": 90
            }
          ]
        }
      }
    },
