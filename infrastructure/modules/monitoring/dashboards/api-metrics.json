    {
      "type": "text",
      "x": 0,
      "y": 14,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## Cache Performance"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 15,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "Cache Hit Rate",
        "view": "timeSeries",
        "stacked": false,
        "region": "${AWS_REGION}",
        "metrics": [
          [
            "ServicePro",
            "redis_cache_hit_rate",
            "Environment",
            "${ENVIRONMENT}",
            "Service",
            "servicepro-api",
            { "stat": "Average", "period": 60 }
          ]
        ],
        "period": 60,
        "yAxis": {
          "left": {
            "min": 0,
            "max": 100,
            "label": "Percentage"
          }
        },
        "annotations": {
          "horizontal": [
            {
              "value": 70,
              "label": "Target",
              "color": "#2ca02c"
            }
          ]
        }
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 15,
      "width": 8,
      "height": 6,
