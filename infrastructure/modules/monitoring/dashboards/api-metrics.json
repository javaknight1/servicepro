            ".",
            ".",
            ".",
            ".",
            {
              "stat": "Sum",
              "period": 60,
              "label": "Misses",
              "color": "#ff7f0e"
            }
          ]
        ],
        "period": 60,
        "yAxis": {
          "left": {
            "min": 0,
            "label": "Count"
          }
        }
      }
    },
