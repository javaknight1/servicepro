{
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "# ServicePro API Monitoring Dashboard"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 1,
      "width": 6,
      "height": 6,
      "properties": {
        "title": "Request Rate",
        "view": "timeSeries",
        "stacked": false,
        "region": "${AWS_REGION}",
        "metrics": [
          [
            "ServicePro",
            "http_requests_total",
            "Environment",
            "${ENVIRONMENT}",
            "Service",
            "servicepro-api",
            { "stat": "Sum", "period": 60 }
          ]
        ],
        "period": 60,
        "yAxis": {
          "left": {
            "min": 0,
            "label": "Requests/min"
          }
        }
      }
    },
    {
      "type": "metric",
      "x": 6,
      "y": 1,
      "width": 6,
      "height": 6,
      "properties": {
        "title": "Response Time (p50, p95, p99)",
        "view": "timeSeries",
        "stacked": false,
        "region": "${AWS_REGION}",
        "metrics": [
          [
            "ServicePro",
            "http_request_duration_ms",
            "Environment",
            "${ENVIRONMENT}",
            "Service",
            "servicepro-api",
            { "stat": "p50", "period": 60, "label": "p50" }
          ],
          [
            ".",
            ".",
            ".",
            ".",
            ".",
            ".",
            { "stat": "p95", "period": 60, "label": "p95" }
          ],
          [
            ".",
            ".",
            ".",
            ".",
            ".",
            ".",
            { "stat": "p99", "period": 60, "label": "p99" }
          ]
        ],
        "period": 60,
        "yAxis": {
          "left": {
            "min": 0,
            "label": "Milliseconds"
          }
        }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 1,
      "width": 6,
      "height": 6,
      "properties": {
        "title": "Error Rate",
        "view": "timeSeries",
        "stacked": false,
        "region": "${AWS_REGION}",
        "metrics": [
          [
            "ServicePro",
            "http_errors_total",
            "Environment",
            "${ENVIRONMENT}",
            "Service",
            "servicepro-api",
            { "stat": "Sum", "period": 60, "color": "#d62728" }
          ]
        ],
        "period": 60,
        "yAxis": {
          "left": {
            "min": 0,
            "label": "Errors/min"
          }
        }
      }
    },
    {
      "type": "metric",
      "x": 18,
      "y": 1,
      "width": 6,
      "height": 6,
      "properties": {
        "title": "Requests In Flight",
        "view": "timeSeries",
        "stacked": false,
        "region": "${AWS_REGION}",
        "metrics": [
          [
            "ServicePro",
            "http_requests_in_flight",
            "Environment",
            "${ENVIRONMENT}",
            "Service",
            "servicepro-api",
            { "stat": "Average", "period": 60 }
          ]
        ],
        "period": 60,
        "yAxis": {
          "left": {
            "min": 0
          }
        }
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 7,
      "width": 24,
      "height": 1,
      "properties": {
